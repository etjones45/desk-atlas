# Car Atlas defaults. Do not edit on the Pi; put overrides in /etc/car-atlas/config.env
# (that file is created by install.sh and wins over anything here).

# Branch the Pi follows for automatic updates
REPO_URL=https://github.com/etjones45/desk-atlas
REPO_BRANCH=car

# Google Drive folders (created 2026-11-08 in ET's Drive)
DRIVE_ROOT_ID=1MDtz0MdP8wSYrJMTbo-mmmNTcK0JkzLw
DRIVE_DASHCAM_ID=1B8RdEvhfc_Bk35iA9ON2iNTZHDmFbHmG
DRIVE_SENTRY_ID=1JfANie1Q0J9mF424Ezawx67P5unRmEnX
DRIVE_STATUS_ID=1GOchM5oPzy5o-gR_31qgqATBywgV4R6H

# Virtual USB drive the car records to
TESLACAM_IMAGE=/var/lib/car-atlas/teslacam.img
# Size in GB, or auto = use the SD card's free space (keeps 5 GB spare). Only grows while the drive is empty.
TESLACAM_SIZE_GB=auto

# USB GPS for the coverage map / Find my car (auto = first /dev/ttyACM* or /dev/ttyUSB*)
GPS_DEVICE=auto

# Pi time zone (daily limits follow it)
TIMEZONE=America/Denver

# Networks
STARLINK_SSID=JonesyStarlink
HOME_SSID=Jones_Condo

# Upload speed caps (rclone --bwlimit, bytes/sec; 0 = no cap).
# 375k is about 3 Mbps, which leaves room on the Starlink for phones and FaceTime.
UPLOAD_LIMIT_STARLINK=375k
UPLOAD_LIMIT_OTHER=0
# Max MB of clips to upload per day over Starlink (protects the data plan). Home WiFi is unlimited.
STARLINK_DAILY_UPLOAD_CAP_MB=5000
# Upload Sentry clips over Starlink too (1) or only on home WiFi (0). Dashcam saved clips always go.
UPLOAD_SENTRY_ON_STARLINK=1

# How often things run (seconds)
DISH_POLL_INTERVAL=15
STATUS_INTERVAL=60
UPLOAD_SCAN_INTERVAL=60

# Push alerts through the free ntfy app (topic is generated by install.sh)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Pi temperature (C) that triggers an alert
PI_TEMP_ALERT_C=80

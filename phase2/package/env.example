# Copy to ~/desk-atlas/.env on the Pi (chmod 600). Never commit real values.
# Ethan pastes keys on the Pi only — never into chat or git.
# Face itself needs no key. TTS + webhook + OTA /update do.

XAI_API_KEY=
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=en
XAI_TTS_CODEC=mp3

# Voice-in webhook into the Atlas Grok Bot thread (Phase 0 routine)
ATLAS_WEBHOOK_URL=
ATLAS_SENDER_KEY=
ATLAS_SENDER_HEADER=Authorization
# Older phase-2 names still accepted by some scripts:
# JARVIS_WEBHOOK_URL=
# JARVIS_SENDER_KEY=

DESK_ATLAS_HOST=127.0.0.1
DESK_ATLAS_PORT=8787
DESK_ATLAS_IDLE_TIMEOUT=180
ATLAS_AUDIO=whisplay
ATLAS_RECORD_DEVICE=plughw:whisplaysound,0

# Face (no key required). Live path on Pi is ~/desk-atlas/face.py
DESK_ATLAS_FACE=1
DESK_ATLAS_FACE_W=240
DESK_ATLAS_FACE_H=280
DESK_ATLAS_FACE_FPS=24
# Laptop only:
# DESK_ATLAS_FACE_PREVIEW=/tmp/desk-atlas-face.png

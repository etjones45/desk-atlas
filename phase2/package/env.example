# Copy to /opt/desk-jarvis/env on the Pi (chmod 600). Never commit real values.
# Ethan places XAI_API_KEY himself (secure card / local paste on Pi — never chat).
XAI_API_KEY=
JARVIS_SPEAK_PORT=8080
JARVIS_PLAY=1
JARVIS_VOICE=eve

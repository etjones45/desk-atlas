[Unit]
Description=Desk Jarvis speak server (xAI TTS mouth)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/opt/desk-jarvis
EnvironmentFile=-/opt/desk-jarvis/env
Environment=JARVIS_SPEAK_PORT=8080
Environment=JARVIS_PLAY=1
ExecStart=/usr/bin/python3 /opt/desk-jarvis/speak_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
